#include <stdio.h>

int main() {
    int codigo;

    printf("Digite o codigo de acesso: ");
    scanf("%d", &codigo);

    // Implemente aqui um WHILE.
    // Enquanto codigo != 4321:

    while (codigo != 4321) {
        printf("CODIGO INCORRETO\n");

        printf("Digite o codigo de acesso: ");
        scanf("%d", &codigo);
    }

    printf("ACESSO LIBERADO\n");

    return 0;
}
